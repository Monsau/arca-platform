{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.suite/schemas/discovery/capability-descriptor.json",
  "title": "Arca Platform Capability Descriptor",
  "type": "object",
  "required": ["id", "name", "product", "version", "input_schema", "output_schema"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "input_schema": { "type": "string", "minLength": 1 },
    "output_schema": { "type": "string", "minLength": 1 },
    "required_contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
