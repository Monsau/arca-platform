{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.local/schemas/policy/eval-request.json",
  "title": "Policy Evaluation Request",
  "description": "Neutral RBAC/ABAC policy evaluation request.",
  "type": "object",
  "required": ["subject", "resource", "action"],
  "properties": {
    "subject": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
