{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.local/schemas/policy/role.json",
  "title": "Role Definition",
  "description": "RBAC role with a set of permissions.",
  "type": "object",
  "required": ["role_id", "permissions"],
  "properties": {
    "role_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_type", "action"],
        "properties": {
          "resource_type": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
