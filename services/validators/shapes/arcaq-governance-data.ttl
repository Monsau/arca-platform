    rdfs:label                "Union Européenne" ;
    arcaq:applicableJurisdiction "EU" ;
    arcaq:description         "Réglementation européenne — RGPD, DSP2, DORA, NIS2"  ;
    arcaq:belongsToDomain  arcaq:Domain_Compliance .

arcaq:Jurisdiction_LU
